#!/usr/bin/env bash
# Amp orb setup for Discern MCP and its optional browser checkout.
#
# Supports the Discern checkout names and the legacy Jev names during migration.
# Standalone MCP checkouts skip the browser install when no sibling is present.
#
# The script is idempotent: safe to run repeatedly; warm runs converge fast.
set -euo pipefail

log() { printf '[discern setup %s] %s\n' "$(date -u +%H:%M:%S)" "$*"; }

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

# Prefer the new checkout name; Amp multi-repo projects use ../repos/.
browser=""
for candidate in "$root/../repos/discern-browser" "$root/../discern-browser" "$root/../repos/jev-browser" "$root/../jev-browser"; do
  if [ -f "$candidate/package.json" ]; then
    browser="$(cd "$candidate" && pwd)"
    break
  fi
done

# Discern MCP requires Node >= 22.
node_version="$(node --version 2>/dev/null || true)"
node_major="$(printf '%s' "$node_version" | sed 's/^v\([0-9]*\).*/\1/')"
if [ "${node_major:-0}" -lt 22 ]; then
  log "ERROR: Node >= 22 required, found: ${node_version:-none}"
  exit 1
fi

log "installing Discern MCP dependencies"
npm ci --no-fund --no-audit

log "building Discern MCP"
npm run build

if [ -n "$browser" ]; then
  log "installing Discern Browser dependencies at $browser (first run downloads Chromium)"
  (cd "$browser" && npm ci --no-fund --no-audit)
  log "building Discern Browser"
  (cd "$browser" && npm run build)
else
  log "no browser checkout found; skipped (standalone Discern MCP setup)"
fi

log "done"
